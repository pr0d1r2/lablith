amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

// Every hook's steps: the generated ones, ordered so `cargo run` never races.
local fast = (generated.steps) {
  // nix:T7 (actlith B9): every step that runs `cargo run` waits for this
  // build. Started together on a stale binary, one cargo re-links the
  // executable while another is starting it, and macOS kills that process
  // with no output: a gate step that fails for no reason. Built once
  // first, every later `cargo run` finds it fresh and links nothing.
  ["build"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    check = "cargo build -q --workspace --bins"
    depends = List("clippy")
  }
}

local all = (fast) {
  ...generated.push
  // nix:T7: the vendored schema is the one the pinned hk ships, and
  // pkl/VENDORED.md names its version and sha256. As actlith and pklith.
  // Push only: it evaluates the flake and realises hk's source.
  ["schema-pin"] {
    glob = List("pkl/**", "flake.lock", "nix/guard/schema-pin.sh")
    check = "bash nix/guard/schema-pin.sh"
  }
  // nix:T7: the crate packages, and the packaged crate alone builds; a
  // file the build embeds but the package leaves out fails here, not at
  // publish. As actlith. Push only: it builds the crate again from the
  // tarball.
  ["package"] {
    glob = List("Cargo.toml", "Cargo.lock", "src/**")
    check = "cargo package --locked --allow-dirty -q -p lablith"
  }
  // nix:T7: no dependency with a published advisory. It fetches the
  // advisory database, so it runs at push, which needs the network
  // anyway; the commit-time `deny` step stays offline. As actlith.
  ["deny-advisories"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "cargo deny check advisories"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    // nix:V46: "none", not "git": the git stash is shared by every worktree,
    // so with parallel wave workers one hook pops another checkout's files
    // (actlith nix:B5). hk 2.7.0 keeps patch files in the git dir, so
    // "patch-file" would now be safe; "none" stays until that is measured.
    stash = "none"
    steps = fast
  }
  // nix:T5: subject `type(scope): claim`, at most 72 characters, a body
  // that says why. hk passes the file git gave the hook (MERGE_MSG on a
  // merge).
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "bash nix/guard/commit-msg.sh {{commit_msg_file}}"
      }
      // V25: a feat, fix or perf commit changing src/ adds a CHANGELOG
      // entry. Here, not in pre-commit: only the message says which kind a
      // change is.
      ["changelog-touched"] {
        check = "bash nix/guard/changelog-touched.sh {{commit_msg_file}}"
        depends = List("commit-msg")
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    // hk 2.x stages fixes only in pre-commit unless a hook asks for it.
    stage = true
    steps = all
  }
}
